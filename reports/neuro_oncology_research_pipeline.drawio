        <!-- Stage 4 Fusion -> Stage 5 Dynamics -->
        <mxCell id="edge_13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#60a5fa;strokeWidth=2.5;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_stage4" target="node_stage5">
