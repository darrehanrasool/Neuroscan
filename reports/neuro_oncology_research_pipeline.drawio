        <mxCell id="edge_01" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#38bdf8;strokeWidth=2.5;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_raw_scan" target="node_stage1">
