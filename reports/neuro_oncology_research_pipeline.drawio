        <!-- Stage 2 -> Vascular MRA (Right branch) -->
        <mxCell id="edge_04" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f43f5e;strokeWidth=2.5;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_stage2" target="node_vascular_mra">
          <mxGeometry relative="1" as="geometry" />
