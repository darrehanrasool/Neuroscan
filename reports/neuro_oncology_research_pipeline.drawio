  <diagram id="NeuroOncologyPipeline" name="NeuroScan Research Architecture">
    <mxGraphModel dx="1420" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1600" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Canvas Background / Title Header -->
        <mxCell id="title_banner" value="&lt;b&gt;NEUROSCAN NEXT-GEN RESEARCH ARCHITECTURE&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 13px; font-weight: normal; color: #94a3b8;&quot;&gt;Multi-Modal Hierarchical Anatomical Routing &amp;amp; Biophysical Tumor Growth Diffusion Pipeline&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#090d16;strokeColor=#1e293b;strokeWidth=2;fontColor=#38bdf8;fontSize=18;fontFamily=Helvetica;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="1000" height="60" as="geometry" />
        </mxCell>

        <!-- Node 1: Raw Multi-Parametric MRI Scan -->
        <mxCell id="node_raw_scan" value="&lt;b style=&quot;font-size: 15px; color: #38bdf8;&quot;&gt;Raw Multi-Parametric MRI Scan&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 13px; color: #cbd5e1;&quot;&gt;(T1, T1-CE, T2, FLAIR, 3D TOF-MRA)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#0284c7;strokeWidth=2.5;fontColor=#f8fafc;fontFamily=Helvetica;shadow=1;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="380" y="110" width="440" height="70" as="geometry" />
        </mxCell>

        <!-- Node 2: Stage 1 Pre-Processing -->
        <mxCell id="node_stage1" value="&lt;b style=&quot;font-size: 14px; color: #38bdf8;&quot;&gt;STAGE 1: PRE-PROCESSING &amp;amp; SKULL STRIPPING&lt;/b&gt;&lt;hr style=&quot;border-color: #334155;&quot;/&gt;&lt;div style=&quot;text-align: left; font-size: 12px; line-height: 1.5; color: #e2e8f0;&quot;&gt;• &lt;b&gt;HD-BET:&lt;/b&gt; Deep Neural Brain Extraction &amp;amp; Calvarium Stripping&lt;br/&gt;• &lt;b&gt;N4ITK:&lt;/b&gt; Low-Frequency B0/B1 RF Bias Field Correction&lt;br/&gt;• &lt;b&gt;Rigid Co-registration:&lt;/b&gt; Mutual Information Alignment to SRI24 Atlas&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontFamily=Helvetica;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="220" width="440" height="100" as="geometry" />
        </mxCell>

        <!-- Node 3: Stage 2 Anatomical Parcellation -->
        <mxCell id="node_stage2" value="&lt;b style=&quot;font-size: 14px; color: #818cf8;&quot;&gt;STAGE 2: ANATOMICAL PARCELLATION&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 12px; color: #c7d2fe;&quot;&gt;(TotalSegmentator MRI / Self-Configuring 3D nnU-Net Engine)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1b4b;strokeColor=#6366f1;strokeWidth=2;fontColor=#f8fafc;fontFamily=Helvetica;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="360" width="440" height="70" as="geometry" />
        </mxCell>

        <!-- Node 4: Left Branch - Tissue Bed Parcellation -->
        <mxCell id="node_tissue_bed" value="&lt;b style=&quot;font-size: 13.5px; color: #34d399;&quot;&gt;TISSUE BED PARCELLATION&lt;/b&gt;&lt;hr style=&quot;border-color: #065f46;&quot;/&gt;&lt;div style=&quot;text-align: left; font-size: 11.5px; line-height: 1.6; color: #e2e8f0;&quot;&gt;• &lt;b&gt;Calvarium &amp;amp; Dura:&lt;/b&gt; Outer meningeal boundaries&lt;br/&gt;• &lt;b&gt;Supratentorial Cortex:&lt;/b&gt; Frontal, Temporal, Parietal, Occipital&lt;br/&gt;• &lt;b&gt;Sella Turcica / Skull Base:&lt;/b&gt; Sphenoid &amp;amp; suprasellar cistern&lt;br/&gt;• &lt;b&gt;Infratentorial:&lt;/b&gt; Cerebellum &amp;amp; Brainstem/Pons&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2;fontColor=#f8fafc;fontFamily=Helvetica;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="140" y="470" width="400" height="110" as="geometry" />
        </mxCell>

        <!-- Node 5: Right Branch - Vascular MRA Segmentation -->
        <mxCell id="node_vascular_mra" value="&lt;b style=&quot;font-size: 13.5px; color: #fb7185;&quot;&gt;VASCULAR MRA SEGMENTATION&lt;/b&gt;&lt;hr style=&quot;border-color: #9f1239;&quot;/&gt;&lt;div style=&quot;text-align: left; font-size: 11.5px; line-height: 1.6; color: #e2e8f0;&quot;&gt;• &lt;b&gt;Circle of Willis:&lt;/b&gt; ACom, PCom &amp;amp; anastomotic ring&lt;br/&gt;• &lt;b&gt;Middle Cerebral Artery (MCA):&lt;/b&gt; M1/M2 Sylvian branches&lt;br/&gt;• &lt;b&gt;Feeding Trunks:&lt;/b&gt; Basilar &amp;amp; Internal Carotid Arteries (ICA)&lt;br/&gt;• &lt;b&gt;Vessel Encasement &amp;amp; Elastic Strain:&lt;/b&gt; Hemodynamic risk&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#881337;strokeColor=#f43f5e;strokeWidth=2;fontColor=#f8fafc;fontFamily=Helvetica;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="470" width="400" height="110" as="geometry" />
        </mxCell>

        <!-- Node 6: Stage 3 Regional Router -->
        <mxCell id="node_stage3" value="&lt;b style=&quot;font-size: 14px; color: #fbbf24;&quot;&gt;STAGE 3: REGIONAL ANATOMICAL ROUTER&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 12px; color: #fde68a;&quot;&gt;Evaluates anatomical tissue compartment &amp;amp; routes to specialized sub-networks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#451a03;strokeColor=#f59e0b;strokeWidth=2;fontColor=#f8fafc;fontFamily=Helvetica;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="620" width="440" height="70" as="geometry" />
        </mxCell>

        <!-- Node 7: Model A - Glial Tumor Specialist -->
        <mxCell id="node_model_a" value="&lt;b style=&quot;font-size: 13px; color: #f87171;&quot;&gt;MODEL A: GLIAL TUMOR SPECIALIST&lt;/b&gt;&lt;hr style=&quot;border-color: #7f1d1d;&quot;/&gt;&lt;div style=&quot;text-align: left; font-size: 11.5px; line-height: 1.5; color: #fecaca;&quot;&gt;• &lt;b&gt;Infiltrative Glioblastoma (GBM)&lt;/b&gt;&lt;br/&gt;• White matter tract migration&lt;br/&gt;• Central necrotic core volume&lt;br/&gt;• T2/FLAIR vasogenic edema halo&lt;br/&gt;• Hypervascular neo-angiogenesis&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#450a0a;strokeColor=#ef4444;strokeWidth=2;fontColor=#f8fafc;fontFamily=Helvetica;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="730" width="310" height="130" as="geometry" />
        </mxCell>

        <!-- Node 8: Model B - Dural Mass Specialist -->
        <mxCell id="node_model_b" value="&lt;b style=&quot;font-size: 13px; color: #fb923c;&quot;&gt;MODEL B: DURAL MASS SPECIALIST&lt;/b&gt;&lt;hr style=&quot;border-color: #7c2d12;&quot;/&gt;&lt;div style=&quot;text-align: left; font-size: 11.5px; line-height: 1.5; color: #fed7aa;&quot;&gt;• &lt;b&gt;Dural Convexity Meningioma&lt;/b&gt;&lt;br/&gt;• Extra-axial cortical displacement&lt;br/&gt;• Pathognomonic dural tail sign&lt;br/&gt;• Calvarium bone hyperostosis&lt;br/&gt;• Venous sinus patency assessment&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#431407;strokeColor=#f97316;strokeWidth=2;fontColor=#f8fafc;fontFamily=Helvetica;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="445" y="730" width="310" height="130" as="geometry" />
        </mxCell>

        <!-- Node 9: Model C - Sellar Mass Specialist -->
        <mxCell id="node_model_c" value="&lt;b style=&quot;font-size: 13px; color: #c084fc;&quot;&gt;MODEL C: SELLAR MASS SPECIALIST&lt;/b&gt;&lt;hr style=&quot;border-color: #581c87;&quot;/&gt;&lt;div style=&quot;text-align: left; font-size: 11.5px; line-height: 1.5; color: #e9d5ff;&quot;&gt;• &lt;b&gt;Pituitary Macroadenoma&lt;/b&gt;&lt;br/&gt;• Sellar fossa ballooning / expansion&lt;br/&gt;• Suprasellar optic chiasm lift&lt;br/&gt;• Cavernous sinus ICA encasement&lt;br/&gt;• Sphenoid sinus bony erosion&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b0764;strokeColor=#a855f7;strokeWidth=2;fontColor=#f8fafc;fontFamily=Helvetica;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="810" y="730" width="310" height="130" as="geometry" />
        </mxCell>

        <!-- Node 10: Stage 4 Joint Multi-Scale Fusion -->
        <mxCell id="node_stage4" value="&lt;b style=&quot;font-size: 14px; color: #60a5fa;&quot;&gt;STAGE 4: JOINT MULTI-SCALE FUSION &amp;amp; BIOMETRICS&lt;/b&gt;&lt;hr style=&quot;border-color: #1e3a8a;&quot;/&gt;&lt;div style=&quot;text-align: left; font-size: 12px; line-height: 1.5; color: #dbeafe;&quot;&gt;• &lt;b&gt;3D Volumetric Segmentation:&lt;/b&gt; Multi-compartment Dice &amp;amp; 95% Hausdorff Distance&lt;br/&gt;• &lt;b&gt;Vessel Encasement Index:&lt;/b&gt; Circumferential degree ($0^\circ - 360^\circ$) of arterial contact&lt;br/&gt;• &lt;b&gt;Uncertainty Quantification:&lt;/b&gt; Monte Carlo Dropout Epistemic Confidence Maps&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#172554;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f8fafc;fontFamily=Helvetica;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="900" width="440" height="95" as="geometry" />
        </mxCell>

        <!-- Node 11: Stage 5 Tumor Growth Dynamics (PDEs) -->
        <mxCell id="node_stage5" value="&lt;b style=&quot;font-size: 14px; color: #a78bfa;&quot;&gt;STAGE 5: BIOPHYSICAL TUMOR GROWTH DYNAMICS (PDE)&lt;/b&gt;&lt;hr style=&quot;border-color: #3b0764;&quot;/&gt;&lt;div style=&quot;text-align: left; font-size: 12px; line-height: 1.5; color: #ede9fe;&quot;&gt;• &lt;b&gt;Reaction-Diffusion Model:&lt;/b&gt; $\partial u/\partial t = \nabla \cdot (D(\mathbf{x})\nabla u) + \rho u(1 - u)$&lt;br/&gt;• &lt;b&gt;Anisotropic Tensor:&lt;/b&gt; $D(\mathbf{x})$ guided by DTI white matter tracts ($D_w \approx 5 \cdot D_g$)&lt;br/&gt;• &lt;b&gt;Mass Effect / Midline Shift:&lt;/b&gt; Elastodynamic Navier-Cauchy solid tissue stress&lt;br/&gt;• &lt;b&gt;Trajectory Simulation:&lt;/b&gt; 30, 60 &amp;amp; 90-day volumetric invasion forecasting&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e1065;strokeColor=#8b5cf6;strokeWidth=2;fontColor=#f8fafc;fontFamily=Helvetica;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="1030" width="440" height="110" as="geometry" />
        </mxCell>

        <!-- Node 12: Stage 6 Clinical PACS & 3D HUD -->
        <mxCell id="node_stage6" value="&lt;b style=&quot;font-size: 14.5px; color: #2dd4bf;&quot;&gt;STAGE 6: CLINICAL PACS &amp;amp; 3D HOLOGRAPHIC HUD&lt;/b&gt;&lt;hr style=&quot;border-color: #134e4a;&quot;/&gt;&lt;div style=&quot;text-align: left; font-size: 12px; line-height: 1.5; color: #ccfbf1;&quot;&gt;• &lt;b&gt;Interactive Three.js Hologram:&lt;/b&gt; Multi-layer Skull, Arteries, Cortex &amp;amp; Tumor&lt;br/&gt;• &lt;b&gt;Dual-Display Stage Projector:&lt;/b&gt; Zero-latency BroadcastChannel synchronization&lt;br/&gt;• &lt;b&gt;Human-in-the-Loop Feedback:&lt;/b&gt; Clinician Accept/Correct/Reject Audit Log&lt;br/&gt;• &lt;b&gt;Automated Radiology Dossier:&lt;/b&gt; Structured DICOM / PDF diagnostic report&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#042f2e;strokeColor=#14b8a6;strokeWidth=2.5;fontColor=#f8fafc;fontFamily=Helvetica;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="1180" width="440" height="110" as="geometry" />
        </mxCell>

        <!-- CONNECTING EDGES & FLOW ARROWS -->

